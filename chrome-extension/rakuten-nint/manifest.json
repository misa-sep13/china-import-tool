{
  "manifest_version": 3,
  "name": "楽天リサーチ連携（Nint取り込み）",
  "version": "3.0",
  "description": "楽天の検索結果にNintボタンを出し、開いたNintの画面から売上データをリサーチツールへ取り込む",
  "permissions": [
    "tabs",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://search.rakuten.co.jp/*",
    "https://ec.nint.jp/*",
    "https://china-import-tool.onrender.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://search.rakuten.co.jp/search/mall/*"],
      "js": ["rakuten.js"]
    },
    {
      "matches": ["https://ec.nint.jp/*"],
      "js": ["nint.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icon.png", "inject.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icon.png"
  }
}
